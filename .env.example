# Names only, never values — copy to .env.local and fill in.
#
# All three are optional locally: with no TURSO_DATABASE_URL the app opens
# file:.data/todo.db, and with no ADMIN_KEY login is disabled (the app still
# builds and runs).

# The shared Turso instance (tables here are namespaced todo_).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# The shared master password across *.justin06lee.dev. Sessions stay per-site.
ADMIN_KEY=
